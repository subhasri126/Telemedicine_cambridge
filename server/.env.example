PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=carebridge
DB_PASSWORD=replace-me
DB_NAME=carebridge_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Backend-only OpenAI configuration. Never use a VITE_ variable for these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Use demo for zero-cost local development. Use twilio only with valid credentials.
SMS_MODE=demo

# Optional backend-only SMS gateway configuration.
# Twilio credentials must never be exposed to the frontend.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shared secret for the SMS provider's status and inbound webhooks.
SMS_WEBHOOK_SECRET=
